[Unit]
Description=Galaxy XR sec_efs partition (Samsung factory data), read-only
Documentation=file:///usr/share/doc/galaxyxr-base-partitions/README.md
# The service mounts it before udev; this unit is for systemd and for mounting it again
After=galaxyxr-base-partitions.service

[Mount]
What=/dev/disk/by-partlabel/sec_efs
Where=/run/platform/sec_efs
Type=ext4
Options=ro,nosuid,nodev,noload,errors=remount-ro
