#!/bin/sh
# Prints debian/galaxyxr-firmware.links: for every firmware file in apnhlos's image/ and
# vendor's firmware/, a link of the same name in /usr/lib/firmware into /run/platform.
# apnhlos wins a name both have, as in Android. Vendor's absolute links are followed into
# /run/platform/vendor; those that leave vendor (for /data or persist, which Android fills)
# are left out. wlan_mac.bin, ath12k's board-2.bin and the Bluetooth NVM, which
# galaxyxr-firmware.service makes at boot, link into /run/galaxyxr-firmware instead; board-2.bin
# from updates/, ahead of linux-firmware's. Files no driver requests on a retail unit (REV07 and later) are left out
# too: firmware of other chips, test images and prototype boards' files.
# Mainline kernels ask for the ADSP and CDSP firmware as qcom/halliday/samsung/xrvst2/
# adsp.mbn and cdsp.mbn: these link to the split .mdt, and the .bNN segments, which the
# kernel loads by name from the same directory, get links there too.
# The GPU's zap shader links there as well, a740v3_zap.mbn, which is one whole image.
# Mainline's GPU driver asks for qcom/a740v3_sqe.fw and qcom/gmu_gen70200.bin: these link
# from updates/qcom, ahead of linux-firmware's GMU, which is another build than vendor's.
# Mainline's Bluetooth driver asks for qca/hmtbtfw20.tlv and qca/hmtnv20.b21: these link
# from updates/qca, ahead of linux-firmware's rampatch, which is another build too. The
# rampatch is vendor's file; the NVM is vendor's with its bt_nvm_loading.xml applied.
# Mainline's cs35l45 driver asks for the speaker amplifiers' protection firmware as
# cirrus/cs35l45-dsp1-spk-prot-samsung-xrvst2.wmfw and, per amplifier, its tuning with the
# amplifier's name after it: vendor's wf files for the woofers and tw for the tweeters.
#
#   tools/firmware-links [APNHLOS VENDOR] > debian/galaxyxr-firmware.links
#
# APNHLOS and VENDOR are where the partitions are mounted, /run/platform/apnhlos and
# /run/platform/vendor by default; apnhlos with shortname=lower, as Android mounts it.
# Reading vendor's build.prop for the header needs root.
set -e

apnhlos=${1:-/run/platform/apnhlos}
vendor=${2:-/run/platform/vendor}
[ -d "$apnhlos/image" ] && [ -d "$vendor/firmware" ] || {
    echo "usage: ${0##*/} [APNHLOS VENDOR]: no $apnhlos/image or $vendor/firmware" >&2
    exit 1
}

names() {
    (cd "$1" && find . -mindepth 1 \( -type f -o -type l \) | sed 's|^\./||' | LC_ALL=C sort) |
        while read -r name; do
            case $name in
                # Other chips
                a620_zap.* | a621_gmu.bin | a650_sqe.fw | CAMERA_ICP_*.elf | vpu20_* | vpu30_*) ;;
                # Test images; the DT boots the ICP through PIL, from CAMERA_ICP.mdt
                CAMERA_ICP.elf | *_unsigned.mbn) ;;
                # Only prototype boards ask for these: amps without the tw or wf part name,
                # s2mm006_fw.bin instead of dk4_s2mm006_fw.bin, kiwi's .u20 board files
                cs35l45-dsp1-* | s2mm006_fw.bin | kiwi/*.u20) ;;
                *) echo "$name" ;;
            esac
        done
}

fingerprint=$(sed -n 's/^ro\.vendor\.build\.fingerprint=//p' "$vendor/build.prop" 2> /dev/null) || :
echo "# Made by tools/firmware-links from ${fingerprint:-an unknown vendor}"
{
    echo "wlan/qca_cld/kiwi_v2/wlan_mac.bin run/galaxyxr-firmware/wlan/qca_cld/kiwi_v2/wlan_mac.bin"
    echo "updates/ath12k/WCN7850/hw2.0/board-2.bin run/galaxyxr-firmware/ath12k/WCN7850/hw2.0/board-2.bin"
    echo "updates/qca/hmtnv20.b21 run/galaxyxr-firmware/qca/hmtnv20.b21"
    names "$apnhlos/image" | while read -r name; do
        echo "$name run/platform/apnhlos/image/$name"
    done
    for dsp in adsp cdsp; do
        [ -f "$apnhlos/image/$dsp.mdt" ] || continue
        echo "qcom/halliday/samsung/xrvst2/$dsp.mbn run/platform/apnhlos/image/$dsp.mdt"
        names "$apnhlos/image" | grep "^$dsp\.b[0-9][0-9]\$" | while read -r name; do
            echo "qcom/halliday/samsung/xrvst2/$name run/platform/apnhlos/image/$name"
        done
    done
    if [ -f "$apnhlos/image/a740v3_zap.mbn" ]; then
        echo "qcom/halliday/samsung/xrvst2/a740v3_zap.mbn run/platform/apnhlos/image/a740v3_zap.mbn"
    fi
    for gpu in a740v3_sqe.fw gmu_gen70200.bin; do
        [ -f "$vendor/firmware/$gpu" ] || continue
        echo "updates/qcom/$gpu run/platform/vendor/firmware/$gpu"
    done
    if [ -f "$vendor/firmware/hmtbtfw20.tlv" ]; then
        echo "updates/qca/hmtbtfw20.tlv run/platform/vendor/firmware/hmtbtfw20.tlv"
    fi
    if [ -f "$vendor/firmware/cs35l45-wf-dsp1-spk-prot.wmfw" ]; then
        amp=cirrus/cs35l45-dsp1-spk-prot-samsung-xrvst2
        echo "$amp.wmfw run/platform/vendor/firmware/cs35l45-wf-dsp1-spk-prot.wmfw"
        for speaker in wooferl:wf wooferr:wf tweeterl:tw tweeterr:tw; do
            echo "$amp-${speaker%:*}.bin run/platform/vendor/firmware/cs35l45-${speaker#*:}-dsp1-spk-prot.bin"
        done
    fi
    names "$vendor/firmware" | while read -r name; do
        target=run/platform/vendor/firmware/$name
        if [ -L "$vendor/firmware/$name" ]; then
            link=$(readlink "$vendor/firmware/$name")
            case $link in
                /vendor/*)
                    if [ ! -e "$vendor/${link#/vendor/}" ]; then
                        echo "left out: $name -> $link, which vendor doesn't have" >&2
                        continue
                    fi
                    target=run/platform/vendor/${link#/vendor/}
                    ;;
                /*)
                    echo "left out: $name -> $link" >&2
                    continue
                    ;;
            esac
        fi
        echo "$name $target"
    done
} | LC_ALL=C sort -s -u -k 1,1 | awk '{ print $2 " usr/lib/firmware/" $1 }'
